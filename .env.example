# SCOPE environment variables.
#
# Copy this file to .env and fill in what you need. Everything is optional --
# defaults are coded into src/scope/{agent,tools,eval}/*.py and the YAML
# configs/. The runtime reads the .env via your shell or pip-installed
# python-dotenv (we don't auto-load .env from Python).

# -----------------------------------------------------------------------------
# Agent (SLM planner) -- OpenAI-compatible endpoint
# -----------------------------------------------------------------------------
AGENT_API_BASE=http://localhost:11434/v1
AGENT_MODEL_ID=qwen3:30b-a3b
AGENT_API_KEY=ollama
# AGENT_TOOL_CHOICE=auto         # auto | required | none (default: auto)
# AGENT_AUTO_PICK=1              # if set, pick the first available served model

# -----------------------------------------------------------------------------
# VLM (perception backend)
# -----------------------------------------------------------------------------
VLM_MODEL=Moondream2             # Moondream2 | Moondream3 | Qwen
# VLM_KIND=                       # legacy alias for VLM_MODEL
VLM_MODEL_URL=                    # leave blank for Moondream Cloud
                                  # set http://localhost:2020 for moondream-station
                                  # set http://localhost:8000/v1 for Qwen via vLLM
# VLM_BASE_URL=                   # legacy alias for VLM_MODEL_URL
VLM_MODEL_ID=                     # e.g. Qwen/Qwen2.5-VL-7B-Instruct for the Qwen branch
# VLM_DEVICE=                     # optional for local VLMs: cuda | mps | cpu; auto-detected if unset
# VLM_API_KEY=                    # generic VLM key; falls through to MOONDREAM_API_KEY
MOONDREAM_API_KEY=                # required for Moondream Cloud
# VLM_AUTO_INIT=1                 # set to 0 to skip VLM construction at import

# -----------------------------------------------------------------------------
# Judge (LLM-as-Judge for benchmark evaluation)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=                   # used by the judge unless JUDGE_API_KEY is set
# JUDGE_API_BASE=https://api.openai.com/v1
# JUDGE_MODEL_ID=gpt-4o
# JUDGE_API_KEY=                  # overrides OPENAI_API_KEY for the judge only
# OPENAI_BASE_URL=                # legacy fallback for JUDGE_API_BASE

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
# SCOPE_CONFIG=                   # absolute path to a YAML config override
# BLENDER_BIN=                    # full Blender binary path if `blender` is not on PATH
# PYTHON_BIN=python               # interpreter for judge/metrics in scripts/run_eval_pipeline.sh

# -----------------------------------------------------------------------------
# Host paths for scripts/run_shard.sh (all optional; defaults are inside the repo)
# Put real machine paths in your untracked .env, never in tracked files.
# -----------------------------------------------------------------------------
# SCOPE_RESULTS_DIR=./results          # <tag>/<scene>.csv, .log and scratch land here
# SCOPE_SCENES_DIR=./benchmark/scenes  # holds <scene>/<scene>.blend
# SCOPE_SHARDS_DIR=                    # per-scene question CSVs; default splits benchmark/scope_536.csv
# SCOPE_PRESETS_HOST=~/.config/blender/4.4/scripts/presets/camera
# HF_CACHE_HOST=~/.cache/huggingface   # mounted at /hf inside the container
# BLENDER_IMAGE=scope-blender:gpu      # built by docker/build-gpu.sh

# -----------------------------------------------------------------------------
# Capture and agent-loop knobs
# -----------------------------------------------------------------------------
# SCOPE_KEEP_CAPTURES=0      # 1 keeps every full-resolution capture (default: a ring)
# SCOPE_CAPTURE_RING=8       # how many recent captures the ring keeps
# SCOPE_SAMPLE_EVERY=25      # keep a thumbnail of every Nth frame for auditing (0 = off)
# SCOPE_SAMPLE_EDGE=512      # thumbnail longest edge, px
# SCOPE_VLM_MAX_PIXELS=2073600  # pixel budget for frames sent to the VLM (1920*1080)
# SCOPE_VLM_COORD_SPACE=auto # how VLM box coordinates are read: auto | fraction | pixel
# SCOPE_MAX_TURNS=40         # turn ceiling per question; a looping planner ends its row, not the run
# SCOPE_COLOUR_MIN=3.0       # a frame below this colourfulness counts as grey
# SCOPE_RUN_COLOUR_FLOOR=6.0 # a shard whose median frame is below this is flagged as rendered without colour
# SCOPE_RUN_GREY_FRACTION=0.25  # ... or whose grey-frame share is above this

# -----------------------------------------------------------------------------
# Judge
# -----------------------------------------------------------------------------
# JUDGE_CONCURRENCY=8        # judge calls in flight; 1 restores serial behaviour
# JUDGE_TRANSCRIPT_CAP=24000 # characters of transcript sent to the judge (head + tail kept)
