# SCOPE environment variables.
#
# Copy this file to .env and fill in what you need. Everything is optional --
# defaults are coded into src/scope/{agent,tools,eval}/*.py and the YAML
# configs/. scripts/run_eval_pipeline.sh loads .env itself; before any other command,
# load it into your shell with:  set -a; source .env; set +a

# -----------------------------------------------------------------------------
# Default: one vLLM server answers both the planner and the vision tools.
# gemma-4-26B-A4B-it, measured on dataset v2 as run tB08 (77.6%, three-judge panel).
# Start the server with the command in docs/CONFIGURATION.md ("Measured recipes"), or
# point these at any OpenAI-compatible endpoint that supports tool calling.
# -----------------------------------------------------------------------------

# Agent (planner): OpenAI-compatible endpoint with tool calling
AGENT_API_BASE=http://localhost:8000/v1
AGENT_MODEL_ID=gemma4-26b-a4b
AGENT_API_KEY=EMPTY
# AGENT_TOOL_CHOICE=auto         # auto | required | none (default: auto)
# AGENT_AUTO_PICK=1              # if set, pick the first available served model

# -----------------------------------------------------------------------------
# VLM (perception backend)
# -----------------------------------------------------------------------------
# VLM_MODEL: Moondream2 | Moondream3 | Qwen, or any other name for an OpenAI-compatible
# vision server at VLM_MODEL_URL (as here: the same Gemma server as the planner).
VLM_MODEL=gemma
# VLM_KIND=                       # legacy alias for VLM_MODEL
VLM_MODEL_URL=http://localhost:8000/v1
                                  # Moondream: blank for Moondream Cloud,
                                  # http://localhost:2020 for scripts/serve_moondream.py,
                                  # photon for in-process Moondream Photon
# VLM_BASE_URL=                   # legacy alias for VLM_MODEL_URL
VLM_MODEL_ID=gemma4-26b-a4b       # the served model name; "gemma", "qwen3" or "molmo" in it
                                  # selects that model's own point and box format
# VLM_DEVICE=                     # optional for local VLMs: cuda | mps | cpu; auto-detected if unset
# VLM_API_KEY=                    # generic VLM key; falls through to MOONDREAM_API_KEY
MOONDREAM_API_KEY=                # only for Moondream Cloud
# VLM_AUTO_INIT=1                 # set to 0 to skip VLM construction at import

# Vision input as in the v2 runs: a 1080p-area pixel budget and automatic coordinate reading.
SCOPE_VLM_MAX_PIXELS=2073600
SCOPE_VLM_COORD_SPACE=auto

# -----------------------------------------------------------------------------
# Judge (LLM-as-Judge for benchmark evaluation)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=                   # used by the judge unless JUDGE_API_KEY is set
# JUDGE_API_BASE=https://api.openai.com/v1
# JUDGE_MODEL_ID=gpt-4o
# JUDGE_API_KEY=                  # overrides OPENAI_API_KEY for the judge only
# OPENAI_BASE_URL=                # legacy fallback for JUDGE_API_BASE

# The v2 judge panel (scripts/13_judge_panel.py; docs/JUDGING.md section 3): three endpoints.
# PANEL_GPT_OSS_URL=http://localhost:8301/v1    # served as gpt-oss-120b
# PANEL_MUSE_URL=http://localhost:8302/v1       # served as muse-glimmer-judge
# PANEL_NEMOTRON_URL=http://localhost:8303/v1   # served as qwen3-nemotron-genrm
# PANEL_<SEAT>_MODEL / _API_KEY / _CONCURRENCY  # optional, e.g. PANEL_MUSE_MODEL=my-muse

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
# SCOPE_CONFIG=                   # absolute path to a YAML config override
# BLENDER_BIN=                    # full Blender binary path if `blender` is not on PATH
# PYTHON_BIN=python               # interpreter for judge/metrics in scripts/run_eval_pipeline.sh
